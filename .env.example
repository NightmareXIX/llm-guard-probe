# Copy this file to .env and fill in the values you need.
# Secrets are read from environment variables only — never put keys in
# configs/*.yaml, the harness will reject configs containing inline secrets.

# Required when a target config uses `adapter: anthropic`.
ANTHROPIC_API_KEY=

# Required when a target config's `auth.envVar` points at this name.
# The actual variable name is whatever you set in `auth.envVar` in your
# target config — TARGET_API_KEY is just the example used in
# configs/generic-http.example.yaml.
TARGET_API_KEY=
